#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x65556ddb04c0 .scope module, "tb_dff_syncres" "tb_dff_syncres" 2 3;
 .timescale -9 -12;
v0x65556ddd6070_0 .var "clk", 0 0;
v0x65556ddd6130_0 .var "d", 0 0;
v0x65556ddd6200_0 .net "q", 0 0, v0x65556ddd5e30_0;  1 drivers
v0x65556ddd6300_0 .var "sync_reset", 0 0;
S_0x65556ddb0650 .scope module, "uut" "dff_syncres" 2 11, 3 10 0, S_0x65556ddb04c0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "sync_reset";
    .port_info 2 /INPUT 1 "d";
    .port_info 3 /OUTPUT 1 "q";
v0x65556dd8a7b0_0 .net "clk", 0 0, v0x65556ddd6070_0;  1 drivers
v0x65556dd8aba0_0 .net "d", 0 0, v0x65556ddd6130_0;  1 drivers
v0x65556ddd5e30_0 .var "q", 0 0;
v0x65556ddd5f00_0 .net "sync_reset", 0 0, v0x65556ddd6300_0;  1 drivers
E_0x65556dd897b0 .event posedge, v0x65556dd8a7b0_0;
    .scope S_0x65556ddb0650;
T_0 ;
    %wait E_0x65556dd897b0;
    %load/vec4 v0x65556ddd5f00_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x65556ddd5e30_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x65556dd8aba0_0;
    %assign/vec4 v0x65556ddd5e30_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x65556ddb04c0;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x65556ddd6070_0;
    %inv;
    %store/vec4 v0x65556ddd6070_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x65556ddb04c0;
T_2 ;
    %vpi_call 2 22 "$dumpfile", "sim/dff_syncres.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x65556ddb04c0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x65556ddd6070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x65556ddd6300_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x65556ddd6130_0, 0, 1;
    %delay 12000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x65556ddd6300_0, 0, 1;
    %delay 8000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x65556ddd6130_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x65556ddd6130_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x65556ddd6130_0, 0, 1;
    %delay 17000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x65556ddd6300_0, 0, 1;
    %delay 15000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x65556ddd6300_0, 0, 1;
    %delay 18000, 0;
    %vpi_call 2 49 "$display", "Synchronous Reset Verification completed successfully." {0 0 0};
    %vpi_call 2 50 "$finish" {0 0 0};
    %end;
    .thread T_2;
