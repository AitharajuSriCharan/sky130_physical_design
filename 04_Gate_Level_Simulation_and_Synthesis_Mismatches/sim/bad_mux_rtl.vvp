#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5b4bae674230 .scope module, "tb_bad_mux" "tb_bad_mux" 2 10;
 .timescale -9 -12;
v0x5b4bae69aba0_0 .var "i0", 0 0;
v0x5b4bae69ac60_0 .var "i1", 0 0;
v0x5b4bae69ad30_0 .var "sel", 0 0;
v0x5b4bae69ae30_0 .net "y", 0 0, v0x5b4bae69aa30_0;  1 drivers
S_0x5b4bae680430 .scope module, "uut" "bad_mux" 2 18, 3 13 0, S_0x5b4bae674230;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "i0";
    .port_info 1 /INPUT 1 "i1";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
v0x5b4bae6487b0_0 .net "i0", 0 0, v0x5b4bae69aba0_0;  1 drivers
v0x5b4bae648ba0_0 .net "i1", 0 0, v0x5b4bae69ac60_0;  1 drivers
v0x5b4bae69a990_0 .net "sel", 0 0, v0x5b4bae69ad30_0;  1 drivers
v0x5b4bae69aa30_0 .var "y", 0 0;
E_0x5b4bae6472d0 .event edge, v0x5b4bae69a990_0;
    .scope S_0x5b4bae680430;
T_0 ;
    %wait E_0x5b4bae6472d0;
    %load/vec4 v0x5b4bae69a990_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5b4bae648ba0_0;
    %store/vec4 v0x5b4bae69aa30_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5b4bae6487b0_0;
    %store/vec4 v0x5b4bae69aa30_0, 0, 1;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5b4bae674230;
T_1 ;
    %vpi_call 2 29 "$dumpfile", "sim/bad_mux_rtl.vcd" {0 0 0};
    %vpi_call 2 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5b4bae674230 {0 0 0};
    %vpi_call 2 33 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 37 "$display", "  [RTL MODE] Starting Behavioral RTL Simulation for bad_mux" {0 0 0};
    %vpi_call 2 39 "$display", "  Monitoring: Time | sel | i0 | i1 | Output y" {0 0 0};
    %vpi_call 2 40 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 41 "$monitor", "  %4t ns |  %b  |  %b |  %b |    %b", $time, v0x5b4bae69ad30_0, v0x5b4bae69aba0_0, v0x5b4bae69ac60_0, v0x5b4bae69ae30_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b4bae69ad30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b4bae69aba0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b4bae69ac60_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 50 "$display", "[t=%0t] Stimulus: Changing i0 to 1 with sel=0 (RTL will fail to update!)", $time {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b4bae69aba0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 56 "$display", "[t=%0t] Stimulus: Changing sel to 1 (RTL catches up)", $time {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b4bae69ad30_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 63 "$display", "[t=%0t] Stimulus: Changing i1 to 1 with sel=1 (RTL will fail to update!)", $time {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b4bae69ac60_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 69 "$display", "[t=%0t] Stimulus: Changing sel to 0 (RTL catches up again)", $time {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b4bae69ad30_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 73 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 74 "$display", "  Simulation Complete." {0 0 0};
    %vpi_call 2 75 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 76 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/tb_bad_mux.v";
    "src/bad_mux.v";
