#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x637bbf070bc0 .scope module, "tb_blocking_caveat" "tb_blocking_caveat" 2 10;
 .timescale -9 -12;
v0x637bbf098960_0 .var "a", 0 0;
v0x637bbf098a20_0 .var "b", 0 0;
v0x637bbf098ac0_0 .var "c", 0 0;
v0x637bbf098bc0_0 .net "d", 0 0, v0x637bbf098710_0;  1 drivers
S_0x637bbf071b40 .scope module, "uut" "blocking_caveat" 2 18, 3 14 0, S_0x637bbf070bc0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "c";
    .port_info 3 /OUTPUT 1 "d";
v0x637bbf0457b0_0 .net "a", 0 0, v0x637bbf098960_0;  1 drivers
v0x637bbf045ba0_0 .net "b", 0 0, v0x637bbf098a20_0;  1 drivers
v0x637bbf098670_0 .net "c", 0 0, v0x637bbf098ac0_0;  1 drivers
v0x637bbf098710_0 .var "d", 0 0;
v0x637bbf0987d0_0 .var "x", 0 0;
E_0x637bbf044560 .event edge, v0x637bbf0987d0_0, v0x637bbf098670_0, v0x637bbf0457b0_0, v0x637bbf045ba0_0;
    .scope S_0x637bbf071b40;
T_0 ;
    %wait E_0x637bbf044560;
    %load/vec4 v0x637bbf0987d0_0;
    %load/vec4 v0x637bbf098670_0;
    %and;
    %store/vec4 v0x637bbf098710_0, 0, 1;
    %load/vec4 v0x637bbf0457b0_0;
    %load/vec4 v0x637bbf045ba0_0;
    %or;
    %store/vec4 v0x637bbf0987d0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x637bbf070bc0;
T_1 ;
    %vpi_call 2 29 "$dumpfile", "sim/blocking_caveat_rtl.vcd" {0 0 0};
    %vpi_call 2 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x637bbf070bc0 {0 0 0};
    %vpi_call 2 33 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 37 "$display", "  [RTL MODE] Starting Behavioral RTL Simulation for blocking_caveat" {0 0 0};
    %vpi_call 2 39 "$display", "  Monitoring: Time | a | b | c | Output d (Expected: (a|b)&c)" {0 0 0};
    %vpi_call 2 40 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 41 "$monitor", "  %4t ns | %b | %b | %b |    %b", $time, v0x637bbf098960_0, v0x637bbf098a20_0, v0x637bbf098ac0_0, v0x637bbf098bc0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098960_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098a20_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098ac0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 50 "$display", "[t=%0t] Stimulus: a=1, b=0, c=1 (Expected d=1; RTL will fail due to stale x!)", $time {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x637bbf098960_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098a20_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x637bbf098ac0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 55 "$display", "[t=%0t] Stimulus: c=0 (Both RTL and GLS output d=0)", $time {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098ac0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 60 "$display", "[t=%0t] Stimulus: c=1 (Now RTL x is already 1, so d catches up to 1)", $time {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x637bbf098ac0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098960_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098a20_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x637bbf098ac0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 68 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 69 "$display", "  Simulation Complete." {0 0 0};
    %vpi_call 2 70 "$display", "======================================================================" {0 0 0};
    %vpi_call 2 71 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/tb_blocking_caveat.v";
    "src/blocking_caveat.v";
